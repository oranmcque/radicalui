# GEMINI_API_KEY: Required for Gemini AI API calls (Chat, Vision, Live Call, Transcribe, TTS).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Self-Hosted Provider Keys (configure in environment / Secrets panel)
DEEPGRAM_API_KEY=""
FISHAUDIO_API_KEY=""
FISHAUDIO_DEFAULT_VOICE_ID=""
NANOGPT_API_KEY=""
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
