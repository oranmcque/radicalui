# GEMINI_API_KEY: Required for Gemini AI API calls (Chat, Vision, Live Call, Transcribe, TTS).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Self-Hosted Provider Keys (configure in environment / Secrets panel)
DEEPGRAM_API_KEY=""
FISHAUDIO_API_KEY=""
FISHAUDIO_DEFAULT_VOICE_ID=""
NANOGPT_API_KEY=""
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
PARALLEL_API_KEY=""

# Modular Web Recon / Search Providers
SEARXNG_BASE_URL="http://localhost:8888"
BRAVE_API_KEY=""
TAVILY_API_KEY=""
CUSTOM_SEARCH_URL=""
CUSTOM_SEARCH_API_KEY=""
MAX_SEARCH_RESULTS="5"

# Persistent Storage Backend (local | mounted | webdav | remote-http)
# Example for Contabo VPS with mounted Hetzner Storage Box:
# PHEONIKZ_STORAGE_MODE="mounted"
# PHEONIKZ_STORAGE_PATH="/mnt/hetzner-box/pheonikz"
PHEONIKZ_STORAGE_MODE="local"
PHEONIKZ_STORAGE_PATH=""
PHEONIKZ_REMOTE_STORAGE_URL=""
PHEONIKZ_REMOTE_STORAGE_USERNAME=""
PHEONIKZ_REMOTE_STORAGE_PASSWORD=""
PHEONIKZ_REMOTE_STORAGE_TOKEN=""
